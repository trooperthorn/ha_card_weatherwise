{
  "name": "weatherwise-card",
  "version": "0.0.0",
  "description": "Home Assistant dashboard card for kiosk displays: an embedded WeatherWise radar map at a configurable zoom (metro or state) with a modeled-conditions headline and hourly strip from the WeatherWise forecast API.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/trooperthorn/ha_card_weatherwise"
  },
  "scripts": {
    "dev": "vite serve dev --config vite.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src dev tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "lit": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  }
}
